# --- Backend ---
ENVIRONMENT=development
JWT_SECRET=change-me-in-every-environment
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# --- MongoDB (BD operativa principal) ---
# replicaSet=rs0: requerido para las transacciones multi-documento de
# core/db_transaction.py (ver servicio mongo-init en docker-compose.yml).
MONGO_URI=mongodb://mongo:27017/?replicaSet=rs0
MONGO_DB_NAME=urbanflet

# --- Redis (cache, tiempo real, colas de oferta) ---
REDIS_URL=redis://redis:6379/0

# --- CORS: orígenes de los 3 clientes web (puertos de Vite en dev) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- PocketBase (dataset crudo yellow taxi, exclusivamente) ---
POCKETBASE_URL=http://pocketbase:8090
POCKETBASE_ADMIN_EMAIL=admin@urbanflet.local
POCKETBASE_ADMIN_PASSWORD=change-me-in-every-environment

# --- ClickHouse (capa Gold) ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=urbanflet_gold
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=change-me-in-every-environment

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:soporte@urbanflet.local

# --- Google Maps (Directions API — solo servidor, Directions no soporta CORS) ---
GOOGLE_MAPS_API_KEY=

# --- Airflow metadata DB ---
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change-me-in-every-environment
AIRFLOW_DB_NAME=airflow
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=change-me-in-every-environment
